{
  "components": {
    "schemas": {
      "ChangeInput": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/ChangeInput.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "author": {
            "description": "Agent or person that made the change",
            "minLength": 1,
            "type": "string"
          },
          "creates": {
            "description": "New Markdown files",
            "items": {
              "$ref": "#/components/schemas/Create"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "message": {
            "description": "Commit message",
            "minLength": 1,
            "type": "string"
          },
          "replacements": {
            "description": "Text replacements in existing Markdown files",
            "items": {
              "$ref": "#/components/schemas/Replacement"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "sentAt": {
            "description": "Time when the author sent the change",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "author",
          "message",
          "sentAt"
        ],
        "type": "object"
      },
      "ChangeOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/ChangeOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "applied": {
            "description": "False when Core rejected the change; nothing was modified",
            "type": "boolean"
          },
          "commit": {
            "description": "Hash of the new commit; empty when Core rejected the change",
            "type": "string"
          },
          "diagnostics": {
            "description": "Validation errors of the workspace with the change applied",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "type": "array"
          },
          "rejections": {
            "description": "Edits that do not fit the current files",
            "items": {
              "$ref": "#/components/schemas/Rejection"
            },
            "type": "array"
          }
        },
        "required": [
          "applied",
          "commit",
          "rejections",
          "diagnostics"
        ],
        "type": "object"
      },
      "Create": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string"
          },
          "path": {
            "description": "Workspace-relative path of the new file",
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "type": "object"
      },
      "Diagnostic": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "description": "Display label of the field; empty when the error is not about a field",
            "type": "string"
          },
          "line": {
            "description": "One-based line number",
            "format": "int64",
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "description": "Workspace-relative path of the source file",
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "field",
          "message"
        ],
        "type": "object"
      },
      "Entry": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Workspace-relative path of the entry file",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "title"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/ErrorModel.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Field": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "description": "Display text of the value; list items are separated by commas",
            "type": "string"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "type": "object"
      },
      "HealthOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/HealthOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "List": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "entryCount": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "description": "Folder name of the list in lists/",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name",
          "description",
          "entryCount"
        ],
        "type": "object"
      },
      "ListOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/ListOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/Entry"
            },
            "type": "array"
          },
          "list": {
            "$ref": "#/components/schemas/List"
          }
        },
        "required": [
          "list",
          "entries"
        ],
        "type": "object"
      },
      "ListsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/ListsOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "lists": {
            "items": {
              "$ref": "#/components/schemas/List"
            },
            "type": "array"
          }
        },
        "required": [
          "lists"
        ],
        "type": "object"
      },
      "Page": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/Page.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "body": {
            "description": "Markdown text after the front matter",
            "type": "string"
          },
          "fields": {
            "description": "Front matter fields in source order",
            "items": {
              "$ref": "#/components/schemas/Field"
            },
            "type": "array"
          },
          "path": {
            "description": "Workspace-relative path of the Markdown file",
            "type": "string"
          },
          "title": {
            "description": "The title or name field; the file name when the page has neither",
            "type": "string"
          }
        },
        "required": [
          "path",
          "title",
          "fields",
          "body"
        ],
        "type": "object"
      },
      "Rejection": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "type": "object"
      },
      "Replacement": {
        "additionalProperties": false,
        "properties": {
          "newText": {
            "type": "string"
          },
          "oldText": {
            "description": "Text that occurs exactly once in the file",
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "description": "Workspace-relative path of an existing file",
            "type": "string"
          }
        },
        "required": [
          "path",
          "oldText",
          "newText"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Superlexical",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/changes": {
      "post": {
        "description": "Core applies one change at a time. It rejects a change when an edit does not fit the current files, when a file changed after the change was sent, or when the result is not valid. A rejected change modifies nothing.",
        "operationId": "apply-change",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Apply a set of edits as one commit"
      }
    },
    "/health": {
      "get": {
        "operationId": "get-health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Report that the server is running"
      }
    },
    "/lists": {
      "get": {
        "operationId": "list-lists",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the lists in the workspace"
      }
    },
    "/lists/{list}": {
      "get": {
        "operationId": "get-list",
        "parameters": [
          {
            "in": "path",
            "name": "list",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get one list and its entries"
      }
    },
    "/page": {
      "get": {
        "operationId": "get-page",
        "parameters": [
          {
            "description": "Workspace-relative path of the Markdown file",
            "explode": false,
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "description": "Workspace-relative path of the Markdown file",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get one Markdown page"
      }
    }
  }
}
