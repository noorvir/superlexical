{
  "name": "superlexical",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "prism/web",
    "ray"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:core dev:ray dev:web",
    "dev:core": "go tool wgo run -file .go -xdir node_modules ./cmd/superlexical serve core/testdata/workspace",
    "dev:ray": "bun --filter @superlexical/ray dev",
    "dev:web": "bun --filter @superlexical/prism-web dev",
    "dev:mobile": "prism/mobile/scripts/run-simulator.sh",
    "generate:api": "go run ./cmd/superlexical openapi > openapi.json && bun --filter @superlexical/prism-web generate:api",
    "build": "bun --filter @superlexical/prism-web build",
    "format": "prettier --check . && test -z \"$(gofmt -l .)\"",
    "format:fix": "prettier --write . && gofmt -w .",
    "typecheck": "go vet ./... && bun --filter '*' typecheck",
    "test": "go test ./...",
    "check": "bun run format && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2"
  }
}
